{
  "name": "cartoonforge",
  "version": "0.2.0",
  "description": "Open-source cartoon renderer: cartoons drawn entirely in code, in many classic styles. Built for coding agents and Instagram Reels.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve . -l 3000",
