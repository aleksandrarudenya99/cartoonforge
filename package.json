    "render": "node skills/cartoonforge/scripts/render.mjs",
    "showcase": "node scripts/showcase.mjs",
    "postinstall": "node scripts/sync-examples.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "hyperframes": "0.9.41"
  },
  "engines": {
    "node": ">=22"
  }
